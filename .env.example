# Kopiere diese Datei nach .env und trage die Werte ein. .env ist in .gitignore.

# Anthropic API. Nur fuer --mode claude noetig, im Mock-Modus optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embedding-Dimension der pgvector-Spalten (siehe migrations/001_init.sql).
EMBEDDING_DIM=1024

# Postgres. Innerhalb von Docker Compose ist der Host "db", lokal "localhost".
POSTGRES_USER=drift
POSTGRES_PASSWORD=drift
POSTGRES_DB=drift
DATABASE_URL=postgresql+psycopg://drift:drift@localhost:5432/drift
